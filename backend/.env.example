# 複製成 .env 後填入實際值。.env 不進版控。
# 連線字串格式：postgresql+psycopg://<user>:<password>@<host>:5432/<database>

DATABASE_URL=postgresql+psycopg://ailearn_app:<在此填入密碼>@127.0.0.1:5432/AILearn

# 隨機產生的應用密鑰（session cookie 簽章用）。產生方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<在此填入隨機字串>

# 允許的前端來源（逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 種子資料的初始密碼（所有種子帳號共用，首次登入後需修改）
SEED_PASSWORD=<在此填入>
